{
  "name": "@edwyn/signature-style",
  "version": "1.4.0",
  "description": "Your personal Signature Style UI theme in one command: Token Cascade, Override Protocol, zero-dependency CSS core. Harmonized — 100% official Catppuccin, per-theme (Mocha dark default, Latte light mode) with the signature Flamingo/Teal accents.",
  "type": "module",
  "license": "MIT",
  "author": "edwyn",
  "keywords": [
    "css",
    "design-system",
    "theme",
    "tokens",
    "react"
  ],
  "main": "./tokens.json",
  "exports": {
    ".": "./tokens.json",
    "./css": "./css/signature-style.css",
    "./react": {
      "types": "./react/index.d.ts",
      "import": "./react/index.js",
      "default": "./react/index.js"
    }
  },
  "files": [
    "css/",
    "react/",
    "tokens.json",
    "SYSTEM_PROMPT.md",
    "STORYBOOK.md",
    "!react/index.ts",
    "!react/ThemeProvider.tsx",
    "!react/primitives.tsx",
    "!react/timeline.tsx",
    "!react/modal.tsx",
    "!react/nav.tsx",
    "!react/viz.tsx",
    "!react/forms.tsx",
    "!react/toast.tsx"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:playground": "node playground/verify-playground.mjs",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "lucide-react": ">=0.400.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^1.72.0",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
